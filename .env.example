# ==============================================================================
# EmailGuard Enterprise Configuration Template (.env.example)
# ==============================================================================

# Application Environment ('development' | 'production' | 'test')
VITE_APP_ENV=development

# Application Base URL
VITE_APP_URL=http://localhost:5173

# Optional: External Machine Learning / Heuristic Phishing Detection API Endpoint
# If left empty, EmailGuard utilizes the built-in transparent heuristic rule engine
VITE_DETECTION_API_URL=
VITE_DETECTION_API_KEY=

# Optional: Supabase / Firebase / PostgreSQL Backend Integration
# For production cloud persistence & multi-user authentication
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: AI Security Analysis Enhancement (e.g. OpenAI / Claude / Gemini API)
# Can be routed through an enterprise backend proxy to avoid exposing frontend secrets
VITE_AI_ANALYSIS_ENABLED=false
VITE_AI_ANALYSIS_ENDPOINT=
